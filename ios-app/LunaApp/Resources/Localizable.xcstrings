    "lock_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private space is safe and waiting for you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre espace privé vous attend en toute sécurité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr privater Bereich ist sicher und wartet auf Sie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu espacio privado está seguro y te espera"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio privato è al sicuro e ti aspetta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu espaço privado está seguro e esperando por você"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのプライベート空間は安全にお待ちしています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 개인 공간이 안전하게 기다리고 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的私人空间安全地等待着您"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的私人空間安全地等待著您"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحتك الخاصة آمنة وتنتظرك"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше личное пространство в безопасности и ждёт вас"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel alanınız güvende ve sizi bekliyor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je privéruimte is veilig en wacht op je"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja prywatna przestrzeń jest bezpieczna i czeka na ciebie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका निजी स्थान सुरक्षित है और आपका इंतज़ार कर रहा है"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt privata utrymme är säkert och väntar på dig"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit private rum er sikkert og venter på dig"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt private rom er trygt og venter på deg"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityinen tilasi on turvassa ja odottaa sinua"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš soukromý prostor je v bezpečí a čeká na vás"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš súkromný priestor je v bezpečí a čaká na vás"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A privát tered biztonságban van és vár rád"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul tău privat este în siguranță și te așteaptă"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš privatni prostor je siguran i čeka vas"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашето лично пространство е в безопасност и ви очаква"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ιδιωτικός σας χώρος είναι ασφαλής και σας περιμένει"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרחב הפרטי שלך בטוח ומחכה לך"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای خصوصی شما امن است و منتظر شماست"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی نجی جگہ محفوظ ہے اور آپ کا انتظار کر رہی ہے"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিগত স্থান নিরাপদ এবং আপনার জন্য অপেক্ষা করছে"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ส่วนตัวของคุณปลอดภัยและรอคุณอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian riêng tư của bạn an toàn và đang chờ bạn"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang pribadi Anda aman dan menunggu Anda"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang peribadi anda selamat dan menunggu anda"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafasi yako ya faragha ni salama na inakungoja"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu espai privat és segur i t'espera"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш приватний простір у безпеці та чекає на вас"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
