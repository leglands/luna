    "article_bbt_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your temperature each morning before getting up. A sustained rise confirms ovulation occurred."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez votre température chaque matin avant de vous lever. Une hausse soutenue confirme que l'ovulation a eu lieu."
          }
        }
      }
    },
    "article_bbt_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BBT tracking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivi de la température basale"
          }
        }
      }
    },
