    "article_pms_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS symptoms typically appear 1-2 weeks before your period and resolve when bleeding starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les symptômes du SPM apparaissent généralement 1 à 2 semaines avant les règles et disparaissent au début des saignements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-Symptome treten typischerweise 1-2 Wochen vor der Periode auf und verschwinden mit Beginn der Blutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los síntomas del SPM suelen aparecer 1-2 semanas antes del periodo y desaparecen al comenzar el sangrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sintomi della SPM compaiono tipicamente 1-2 settimane prima del ciclo e si risolvono con l'inizio del sanguinamento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sintomas da TPM geralmente aparecem 1-2 semanas antes da menstruação e desaparecem quando o sangramento começa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMSの症状は通常、生理の1～2週間前に現れ、出血が始まると治まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS 증상은 보통 생리 1-2주 전에 나타나고 출혈이 시작되면 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经前综合征症状通常在经期前1-2周出现，出血开始后消退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經前綜合症症狀通常在經期前1-2週出現，出血開始後消退。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر أعراض متلازمة ما قبل الحيض عادة قبل 1-2 أسبوع من الدورة وتختفي عند بدء النزيف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תסמיני תסמונת קדם-וסתית מופיעים בדרך כלל 1-2 שבועות לפני המחזור ונעלמים עם תחילת הדימום."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "علائم PMS معمولاً ۱-۲ هفته قبل از قاعدگی ظاهر می‌شوند و با شروع خونریزی برطرف می‌شوند."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS के लक्षण आमतौर पर माहवारी से 1-2 सप्ताह पहले दिखाई देते हैं और रक्तस्राव शुरू होने पर ठीक हो जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS লক্ষণগুলি সাধারণত মাসিকের ১-২ সপ্তাহ আগে দেখা যায় এবং রক্তপাত শুরু হলে সমাধান হয়।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS کی علامات عام طور پر ماہواری سے 1-2 ہفتے پہلے ظاہر ہوتی ہیں اور خون بہنا شروع ہونے پر ختم ہو جاتی ہیں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Симптомы ПМС обычно появляются за 1-2 недели до менструации и проходят с началом кровотечения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Симптоми ПМС зазвичай з'являються за 1-2 тижні до менструації та зникають із початком кровотечі."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objawy PMS pojawiają się zwykle 1-2 tygodnie przed miesiączką i ustępują z początkiem krwawienia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příznaky PMS se obvykle objevují 1-2 týdny před menstruací a ustupují s nástupem krvácení."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príznaky PMS sa zvyčajne objavujú 1-2 týždne pred menštruáciou a ustupujú s nástupom krvácania."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A PMS tünetei jellemzően 1-2 héttel a menstruáció előtt jelentkeznek és a vérzés megkezdésével elmúlnak."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Simptomele SPM apar de obicei cu 1-2 săptămâni înainte de menstruație și dispar la începutul sângerării."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Симптомите на ПМС обикновено се появяват 1-2 седмици преди менструацията и отзвучават с началото на кървенето."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simptomi PMS-a obično se pojavljuju 1-2 tjedna prije menstruacije i nestaju s početkom krvarenja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα συμπτώματα ΠΕΣ εμφανίζονται συνήθως 1-2 εβδομάδες πριν την περίοδο και υποχωρούν με την έναρξη της αιμορραγίας."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS belirtileri genellikle adet döneminden 1-2 hafta önce ortaya çıkar ve kanama başladığında geçer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-symptomer opstår typisk 1-2 uger før menstruationen og forsvinder, når blødningen starter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-symtom uppträder vanligtvis 1-2 veckor före mens och försvinner när blödningen börjar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-symptomer dukker vanligvis opp 1-2 uker før menstruasjonen og forsvinner når blødningen starter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-oireet ilmaantuvat tyypillisesti 1-2 viikkoa ennen kuukautisia ja häviävät vuodon alkaessa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS-symptomen verschijnen doorgaans 1-2 weken voor de menstruatie en verdwijnen wanneer de bloeding begint."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els símptomes de la SPM apareixen normalment 1-2 setmanes abans de la regla i desapareixen quan comença el sagnat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gejala PMS biasanya muncul 1-2 minggu sebelum menstruasi dan hilang saat perdarahan dimulai."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gejala PMS biasanya muncul 1-2 minggu sebelum haid dan hilang apabila pendarahan bermula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาการ PMS มักเกิดขึ้น 1-2 สัปดาห์ก่อนมีประจำเดือนและหายไปเมื่อเลือดออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các triệu chứng PMS thường xuất hiện 1-2 tuần trước kỳ kinh và hết khi bắt đầu ra máu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalili za PMS kawaida huonekana wiki 1-2 kabla ya hedhi na hupotea wakati damu inapoanza kutoka."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የPMS ምልክቶች ብዙውን ጊዜ ከወር አበባ በፊት 1-2 ሳምንታት ይታያሉ እና ደም መፍሰስ ሲጀምር ይጠፋሉ።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izimpawu ze-PMS zivamile ukuvela amasonto angu-1-2 ngaphambi kwesikhathi futhi ziphele uma ukopha kuqala."
          }
        }
      }
    },
