            "value": "آماده شوید، قاعدگی شما تا 2 روز دیگر پیش بینی می شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistaudu, kuukautisten odotetaan alkavan 2 päivän kuluttua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תתכונן, המחזור שלך צפוי בעוד יומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार हो जाइए, आपका मासिक धर्म 2 दिनों में आने वाला है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremite se, menstruacija se očekuje za 2 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készülj fel, 2 nap múlva várható a menstruációd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersiaplah, menstruasi Anda diperkirakan dalam 2 hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理予定日は 2 日です。準備をしてください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersedia, tempoh anda dijangka dalam 2 hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør deg klar, mensen forventes om 2 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je klaar, je menstruatie wordt over 2 dagen verwacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj się, miesiączka spodziewana jest za 2 dni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătește-te, menstruația este așteptată în 2 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовьтесь, менструация ожидается через 2 дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripravte sa, menštruácia sa očakáva o 2 dni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör dig redo, din mens väntas om 2 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitayarishe, kipindi chako kinatarajiwa baada ya siku 2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมตัวให้พร้อม ประจำเดือนมาในอีก 2 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olun, adetinizin 2 gün sonra olması bekleniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готуйтеся, місячні очікуються через 2 дні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیار ہو جائیں، آپ کی مدت 2 دنوں میں متوقع ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sẵn sàng, kỳ kinh của bạn sẽ diễn ra sau 2 ngày nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做好准备，预计 2 天后就会来月经。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做好準備，預計 2 天後就會來月經。"
          }
