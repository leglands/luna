    "article_bbt_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your temperature each morning before getting up. A sustained rise confirms ovulation occurred."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez votre température chaque matin avant de vous lever. Une hausse soutenue confirme que l'ovulation a eu lieu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss jeden Morgen vor dem Aufstehen deine Temperatur. Ein anhaltender Anstieg bestätigt, dass der Eisprung stattgefunden hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida su temperatura cada mañana antes de levantarse. Un aumento sostenido confirma que ocurrió la ovulación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura la temperatura ogni mattina prima di alzarti. Un aumento sostenuto conferma che l'ovulazione è avvenuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça sua temperatura todas as manhãs antes de levantar. Um aumento sustentado confirma que a ovulação ocorreu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝起き上がる前に体温を測りましょう。持続的な上昇は排卵が起きたことを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 일어나기 전에 체온을 측정하세요. 지속적인 상승은 배란이 일어났음을 확인합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上起床前测量体温。持续升高说明排卵已发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上起床前測量體溫。持續升高說明排卵已發生。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيسي درجة حرارتك كل صباح قبل النهوض. ارتفاع مستمر يؤكد حدوث الإباضة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדדי את החום כל בוקר לפני הקימה. עלייה מתמשכת מאשרת שהביוץ התרחש."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر صبح قبل از بلند شدن دمای خود را اندازه بگیرید. افزایش مداوم تأیید تخمک‌گذاری است."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुबह उठने से पहले अपना तापमान मापें। निरंतर वृद्धि पुष्टि करती है कि ओव्यूलेशन हुआ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিদিন সকালে ওঠার আগে তাপমাত্রা পরিমাপ করুন। একটি টেকসই বৃদ্ধি নিশ্চিত করে যে ডিম্বস্ফোটন হয়েছে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر صبح اٹھنے سے پہلے اپنا درجہ حرارت ناپیں۔ مستقل اضافہ بیضہ دانی کی تصدیق کرتا ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряйте температуру каждое утро перед подъёмом. Устойчивый рост подтверждает овуляцию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірюйте температуру щоранку перед підйомом. Стійке підвищення підтверджує овуляцію."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mierz temperaturę każdego ranka przed wstaniem. Utrzymujący się wzrost potwierdza owulację."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měř teplotu každé ráno před vstáním. Trvalý vzestup potvrzuje ovulaci."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meraj teplotu každé ráno pred vstávaním. Trvalý nárast potvrdzuje ovuláciu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mérd a hőmérsékleted minden reggel felkelés előtt. A tartós emelkedés megerősíti az ovulációt."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsoară-ți temperatura în fiecare dimineață înainte de a te ridica. O creștere susținută confirmă ovulația."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измервайте температурата си всяка сутрин преди ставане. Устойчивото покачване потвърждава овулацията."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjerite temperaturu svako jutro prije ustajanja. Trajni porast potvrđuje ovulaciju."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρήστε τη θερμοκρασία σας κάθε πρωί πριν σηκωθείτε. Μια σταθερή αύξηση επιβεβαιώνει την ωορρηξία."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sabah kalkmadan önce vücut ısınızı ölçün. Sürekli bir artış yumurtlamanın gerçekleştiğini doğrular."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål din temperatur hver morgen inden du står op. En vedvarende stigning bekræfter ægløsningen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mät din temperatur varje morgon innan du stiger upp. En ihållande ökning bekräftar ägglossningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål temperaturen din hver morgen før du står opp. En vedvarende stigning bekrefter eggløsningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa lämpötilasi joka aamu ennen nousemista. Jatkuva nousu vahvistaa ovulaation."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet je temperatuur elke ochtend voor het opstaan. Een aanhoudende stijging bevestigt de ovulatie."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesura la temperatura cada matí abans d'aixecar-te. Un augment sostingut confirma l'ovulació."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur suhu Anda setiap pagi sebelum bangun. Kenaikan berkelanjutan mengkonfirmasi ovulasi terjadi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur suhu anda setiap pagi sebelum bangun. Kenaikan berterusan mengesahkan ovulasi berlaku."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดอุณหภูมิทุกเช้าก่อนลุกจากเตียง การเพิ่มขึ้นต่อเนื่องยืนยันว่ามีการตกไข่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo nhiệt độ mỗi sáng trước khi rời giường. Sự tăng liên tục xác nhận rụng trứng đã xảy ra."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pima joto lako kila asubuhi kabla ya kuamka. Ongezeko la kudumu linathibitisha kutoa yai."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ከመነሳትዎ በፊት በየጧቱ ሙቀትዎን ይለኩ። ቀጣይነት ያለው ከፍ ማለት ዕንቁላል መልቀቅ መከሰቱን ያረጋግጣል።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kala usuku nosuku ekuseni ngaphambi kokuvuka. Ukukhuphuka okuqhubekayo kuqinisekisa ukuthi ukuqhuma kweqanda kwenzekile."
          }
        }
      }
    },
