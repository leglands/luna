          "stringUnit": {
            "state": "translated",
            "value": "Kein Internet, keine Cloud, kein Tracking. Ihre Daten verlassen nie Ihr Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin internet, sin nube, sin rastreo. Tus datos nunca salen de tu teléfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット不要、クラウド不要、追跡なし。データは端末から外に出ません。"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ኢንተርኔት የለም፣ ክላውድ የለም፣ ክትትል የለም። ውሂብዎ ስልክዎን ፈጽሞ አይለቅም።"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Без интернет, без облак, без проследяване. Данните ви никога не напускат телефона ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ইন্টারনেট নেই, কোনো ক্লাউড নেই, কোনো ট্র্যাকিং নেই। আপনার ডেটা কখনো ফোন ছেড়ে যায় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense internet, sense núvol, sense rastreig. Les teves dades mai surten del teu telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný internet, žádný cloud, žádné sledování. Vaše data nikdy neopustí váš telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internet, ingen sky, ingen sporing. Dine data forlader aldrig din telefon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ίντερνετ, χωρίς cloud, χωρίς παρακολούθηση. Τα δεδομένα σας δεν φεύγουν ποτέ από το τηλέφωνό σας."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون اینترنت، بدون ابر، بدون ردیابی. داده‌های شما هرگز گوشی شما را ترک نمی‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei internetiä, ei pilvipalvelua, ei seurantaa. Tietosi eivät koskaan poistu puhelimestasi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי אינטרנט, בלי ענן, בלי מעקב. הנתונים שלך לעולם לא עוזבים את הטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई इंटरनेट नहीं, कोई क्लाउड नहीं, कोई ट्रैकिंग नहीं। आपका डेटा कभी आपके फ़ोन से बाहर नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez interneta, bez oblaka, bez praćenja. Vaši podaci nikada ne napuštaju vaš telefon."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internet, nincs felhő, nincs követés. Az adataid soha nem hagyják el a telefonodat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa internet, tanpa cloud, tanpa pelacakan. Data Anda tidak pernah meninggalkan ponsel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente internet, niente cloud, niente tracciamento. I tuoi dati non lasciano mai il tuo telefono."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 없음, 클라우드 없음, 추적 없음. 데이터는 절대 휴대폰을 떠나지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada internet, tiada awan, tiada penjejakan. Data anda tidak pernah meninggalkan telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internett, ingen sky, ingen sporing. Dataene dine forlater aldri telefonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen internet, geen cloud, geen tracking. Je gegevens verlaten nooit je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez internetu, bez chmury, bez śledzenia. Twoje dane nigdy nie opuszczają telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem internet, sem nuvem, sem rastreamento. Seus dados nunca saem do seu celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără internet, fără cloud, fără urmărire. Datele tale nu părăsesc niciodată telefonul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без интернета, без облака, без слежки. Ваши данные никогда не покидают телефон."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadny internet, žiadny cloud, žiadne sledovanie. Vaše údaje nikdy neopustia váš telefón."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget internet, inget moln, ingen spårning. Dina data lämnar aldrig din telefon."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna intaneti, hakuna wingu, hakuna ufuatiliaji. Data yako haitori simu yako kamwe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอินเทอร์เน็ต ไม่มีคลาวด์ ไม่มีการติดตาม ข้อมูลของคุณไม่เคยออกจากโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet yok, bulut yok, izleme yok. Verileriniz telefonunuzdan asla çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без інтернету, без хмари, без стеження. Ваші дані ніколи не залишають телефон."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی انٹرنیٹ نہیں، کوئی کلاؤڈ نہیں، کوئی ٹریکنگ نہیں۔ آپ کا ڈیٹا کبھی آپ کے فون سے باہر نہیں جاتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không internet, không đám mây, không theo dõi. Dữ liệu của bạn không bao giờ rời khỏi điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需网络，无需云端，无需追踪。您的数据永远不会离开手机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需網路，無需雲端，無需追蹤。您的資料永遠不會離開手機。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akukho i-inthanethi, akukho ifu, akukho ukulandelela. Idatha yakho ayishiyi ifoni yakho."
          }
        }
      }
    },
    "onboarding_privacy_subtitle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous protégeons vos données avec le même chiffrement que les banques"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll protect your data with the same encryption banks use"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحمي بياناتك بنفس تشفير البنوك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir schützen Ihre Daten mit der gleichen Verschlüsselung wie Banken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegemos tus datos con el mismo cifrado que usan los bancos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行と同じ暗号化であなたのデータを守ります"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggiamo i tuoi dati con la stessa crittografia delle banche"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행과 동일한 암호화로 데이터를 보호합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegemos seus dados com a mesma criptografia dos bancos"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ውሂብዎን ባንኮች በሚጠቀሙበት ተመሳሳይ ምስጠራ እንጠብቃለን"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитаваме данните ви със същото криптиране като банките"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা ব্যাঙ্কের মতো এনক্রিপশন দিয়ে আপনার ডেটা সুরক্ষিত রাখি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegim les teves dades amb el mateix xifratge que fan servir els bancs"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data chráníme stejným šifrováním jako banky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi beskytter dine data med den samme kryptering som banker bruger"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστατεύουμε τα δεδομένα σας με την ίδια κρυπτογράφηση που χρησιμοποιούν οι τράπεζες"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ما از داده‌های شما با همان رمزگذاری بانک‌ها محافظت می‌کنیم"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojaamme tietojasi samalla salauksella kuin pankit"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנחנו מגנים על הנתונים שלך עם אותה הצפנה שבנקים משתמשים בה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपके डेटा को बैंकों जैसी एन्क्रिप्शन से सुरक्षित रखते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše podatke štitimo istom enkripcijom koju koriste banke"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adataidat ugyanazzal a titkosítással védjük, amit a bankok használnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami melindungi data Anda dengan enkripsi yang sama seperti bank"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami melindungi data anda dengan penyulitan yang sama seperti bank"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi beskytter dataene dine med den samme krypteringen som banker bruker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We beschermen je gegevens met dezelfde encryptie als banken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronimy twoje dane tym samym szyfrowaniem co banki"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Protejăm datele tale cu aceeași criptare pe care o folosesc băncile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы защищаем ваши данные тем же шифрованием, что и банки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje chránime rovnakým šifrovaním ako banky"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skyddar dina data med samma kryptering som banker använder"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunalinda data yako na usimbaji sawa na benki"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราปกป้องข้อมูลของคุณด้วยการเข้ารหัสระดับเดียวกับธนาคาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerinizi bankalarla aynı şifrelemeyle koruyoruz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми захищаємо ваші дані тим самим шифруванням, яке використовують банки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کے ڈیٹا کو بینکوں جیسی انکرپشن سے محفوظ رکھتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi bảo vệ dữ liệu của bạn bằng mã hóa cấp ngân hàng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们使用与银行相同的加密技术保护您的数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們使用與銀行相同的加密技術保護您的資料"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sivikela idatha yakho ngokubethela okufanayo okusetshenziwa amabhange"
          }
        }
      }
    },
