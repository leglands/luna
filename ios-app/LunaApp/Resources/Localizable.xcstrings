        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia %lld do seu ciclo. Período esperado em %lld dias."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የእርስዎ ዑደት ቀን %lld። በ%lld ቀናት ውስጥ የሚጠበቀው ጊዜ።"
