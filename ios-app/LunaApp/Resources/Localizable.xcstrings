    "notif_bbt_reminder_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure before getting out of bed for best accuracy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez avant de vous lever pour plus de précision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss vor dem Aufstehen für beste Genauigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide antes de levantarte para mayor precisión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura prima di alzarti per la massima precisione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça antes de sair da cama para maior precisão."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起き上がる前に測ると正確です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확도를 위해 침대에서 일어나기 전에 측정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床前测量最为准确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起床前測量最為準確。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيسي قبل النهوض من السرير للحصول على أفضل دقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדדי לפני הקימה מהמיטה לדיוק מרבי."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از بلند شدن از تخت اندازه بگیرید برای دقت بیشتر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिस्तर से उठने से पहले मापें ताकि सटीकता बनी रहे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সর্বোত্তম নির্ভুলতার জন্য বিছানা থেকে ওঠার আগে পরিমাপ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہترین درستگی کے لیے بستر سے اٹھنے سے پہلے ناپیں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряйте до подъёма с кровати для точности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірюйте до підйому з ліжка для точності."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmierz przed wstaniem z łóżka dla najlepszej dokładności."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měř před vstáním z postele pro nejlepší přesnost."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Meraj pred vstávaním z postele pre najlepšiu presnosť."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mérd meg felkelés előtt a legjobb pontosság érdekében."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Măsoară înainte de a te ridica din pat pentru precizie."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерете преди да станете от леглото за най-добра точност."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmjerite prije ustajanja iz kreveta za najbolju točnost."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μέτρησε πριν σηκωθείς από το κρεβάτι για μεγαλύτερη ακρίβεια."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En doğru sonuç için yataktan kalkmadan önce ölçün."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål inden du står op for bedste nøjagtighed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mät innan du stiger upp för bäst noggrannhet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mål før du står opp for best nøyaktighet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittaa ennen sängystä nousemista tarkkuuden vuoksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet voordat je opstaat voor de beste nauwkeurigheid."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesura abans d'aixecar-te per a la millor precisió."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur sebelum bangun dari tempat tidur untuk akurasi terbaik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukur sebelum bangun dari katil untuk ketepatan terbaik."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัดก่อนลุกจากเตียงเพื่อความแม่นยำที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đo trước khi rời giường để có kết quả chính xác nhất."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pima kabla ya kuamka kitandani kwa usahihi bora."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለተሻለ ትክክለኛነት ከመነሳትዎ በፊት ይለኩ።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kala embhedeni ngaphambi kokuvuka ukuze uthole ubuchwepheshe obungcono."
          }
        }
      }
    },
