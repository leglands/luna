    "insights_calm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictions and trends are hidden. You can browse educational articles below."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prédictions et tendances sont masquées. Vous pouvez parcourir les articles éducatifs ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen und Trends sind ausgeblendet. Du kannst unten Bildungsartikel lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las predicciones y tendencias están ocultas. Puedes explorar los artículos educativos abajo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsioni e tendenze sono nascoste. Puoi sfogliare gli articoli educativi qui sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões e tendências estão ocultas. Você pode ler os artigos educativos abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsões e tendências estão ocultas. Pode consultar os artigos educativos abaixo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測とトレンドは非表示です。下の教育記事をご覧いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측과 트렌드가 숨겨져 있습니다. 아래 교육 기사를 찾아볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测和趋势已隐藏。您可以浏览下方的教育文章。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測和趨勢已隱藏。您可以瀏覽下方的教育文章。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقعات والاتجاهات مخفية. يمكنك تصفح المقالات التعليمية أدناه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחזיות ומגמות מוסתרות. ניתן לעיין במאמרים החינוכיים למטה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌بینی‌ها و روندها پنهان هستند. می‌توانید مقالات آموزشی زیر را مرور کنید."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش‌گوئیاں اور رجحانات چھپے ہوئے ہیں۔ آپ نیچے تعلیمی مضامین دیکھ سکتے ہیں۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भविष्यवाणियाँ और रुझान छिपे हुए हैं। आप नीचे शैक्षिक लेख देख सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভবিষ্যদ্বাণী এবং প্রবণতা লুকানো আছে। আপনি নীচে শিক্ষামূলক নিবন্ধগুলো ব্রাউজ করতে পারেন।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнозы и тренды скрыты. Вы можете просматривать обучающие статьи ниже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнози та тренди приховані. Ви можете переглядати освітні статті нижче."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognozy i trendy są ukryte. Możesz przeglądać artykuły edukacyjne poniżej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předpovědi a trendy jsou skryté. Níže si můžete prohlédnout vzdělávací články."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predpovede a trendy sú skryté. Nižšie si môžete prezerať vzdelávacie články."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Predicțiile și tendințele sunt ascunse. Puteți parcurge articolele educative de mai jos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előrejelzések és trendek rejtve vannak. Az alábbi oktatási cikkeket böngészheti."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогнозите и тенденциите са скрити. Можете да разгледате образователните статии по-долу."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predviđanja i trendovi su skriveni. Možete pregledati obrazovne članke ispod."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προβλέψεις και οι τάσεις είναι κρυμμένες. Μπορείτε να περιηγηθείτε στα εκπαιδευτικά άρθρα παρακάτω."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahminler ve trendler gizlendi. Aşağıda eğitim makalelerini inceleyebilirsiniz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorspellingen en trends zijn verborgen. Je kunt hieronder educatieve artikelen bekijken."
          }
        },
        "da": {
