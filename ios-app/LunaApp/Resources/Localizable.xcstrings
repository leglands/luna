    "article_ovulation_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for cervical mucus changes, mild pelvic pain, and a slight rise in basal body temperature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez les changements de glaire cervicale, une légère douleur pelvienne et une légère hausse de la température basale."
          }
        }
      }
    },
    "article_ovulation_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovulation signs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signes d'ovulation"
          }
        }
      }
    },
    "article_perimenopause_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular cycles, hot flashes, and mood changes are common. Tracking helps identify patterns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cycles irréguliers, bouffées de chaleur et sautes d'humeur sont courants. Le suivi aide à identifier les tendances."
          }
        }
      }
    },
    "article_perimenopause_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Périménopause"
          }
        }
      }
    },
    "article_pms_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS symptoms typically appear 1-2 weeks before your period and resolve when bleeding starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les symptômes du SPM apparaissent généralement 1 à 2 semaines avant les règles et disparaissent au début des saignements."
          }
        }
      }
    },
    "article_pms_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
