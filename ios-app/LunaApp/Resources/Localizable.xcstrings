    "insights_no_data": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre quelques cycles pour voir tes insights."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a few cycles to see your insights."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل بعض الدورات لرؤية إحصاءاتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einige Zyklen, um Einblicke zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra algunos ciclos para ver tus insights."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかのサイクルを記録してinsightsを確認しよう。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra alcuni cicli per vedere le tue informazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 가지 주기를 기록하여 통찰력을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre alguns ciclos para ver seus insights."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ግንዛቤዎችዎን ለማየት ጥቂት ዑደቶችን ይመዝገቡ።"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишете няколко цикъла, за да видите своите прозрения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অন্তর্দৃষ্টি দেখতে কয়েকটি চক্র লগ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreu uns quants cicles per veure les vostres estadístiques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište si několik cyklů, abyste viděli své postřehy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log et par cyklusser for at se din indsigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε μερικούς κύκλους για να δείτε τις πληροφορίες σας."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چند چرخه را ثبت کنید تا بینش خود را ببینید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa muutama jakso nähdäksesi havainnot."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחבר לכמה מחזורים כדי לראות את התובנות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी अंतर्दृष्टि देखने के लिए कुछ चक्र लॉग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabilježite nekoliko ciklusa da vidite svoje uvide."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naplózzon néhány ciklust a betekintések megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat beberapa siklus untuk melihat wawasan Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log beberapa kitaran untuk melihat cerapan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg noen sykluser for å se din innsikt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer een paar cycli om uw inzichten te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestruj kilka cykli, aby zobaczyć swoje spostrzeżenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați câteva cicluri pentru a vedea informațiile dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите несколько циклов, чтобы увидеть свои идеи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte si niekoľko cyklov, aby ste videli svoje štatistiky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga några cykler för att se dina insikter."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekodi mizunguko michache ili kuona maarifa yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสองสามรอบเพื่อดูข้อมูลเชิงลึกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçgörülerinizi görmek için birkaç döngüyü günlüğe kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструйте кілька циклів, щоб побачити свою статистику."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی بصیرتیں دیکھنے کے لیے چند سائیکل لاگ ان کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập một vài chu kỳ để xem thông tin chi tiết của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录几个周期以查看您的见解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄幾個週期以查看您的見解。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngena emijikelezweni embalwa ukuze ubone imininingwane yakho."
          }
        }
      }
    },
