    "settings_icloud_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is end-to-end encrypted. Apple cannot read it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont chiffrées de bout en bout. Apple ne peut pas les lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten sind Ende-zu-Ende-verschlüsselt. Apple kann sie nicht lesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos están cifrados de extremo a extremo. Apple no puede leerlos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono crittografati end-to-end. Apple non può leggerli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são criptografados de ponta a ponta. A Apple não pode lê-los."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus dados são encriptados de ponta a ponta. A Apple não os pode ler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはエンドツーエンドで暗号化されています。Appleは読むことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 종단 간 암호화되어 있습니다. Apple은 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的数据已端到端加密。Apple无法读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的資料已端對端加密。Apple無法讀取。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك مشفرة من طرف إلى طرف. لا تستطيع Apple قراءتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים שלך מוצפנים מקצה לקצה. Apple לא יכולה לקרוא אותם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های شما از سر تا سر رمزنگاری شده‌اند. Apple نمی‌تواند آنها را بخواند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا اینڈ ٹو اینڈ خفیہ ہے۔ Apple اسے نہیں پڑھ سکتا۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा एंड-टू-एंड एन्क्रिप्टेड है। Apple इसे नहीं पढ़ सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটা এন্ড-টু-এন্ড এনক্রিপ্টেড। Apple এটি পড়তে পারে না।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные зашифрованы сквозным шифрованием. Apple не может их прочитать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дані зашифровані наскрізь. Apple не може їх прочитати."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane są szyfrowane end-to-end. Apple nie może ich odczytać."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data jsou šifrována end-to-end. Apple je nemůže přečíst."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše dáta sú šifrované end-to-end. Apple ich nemôže prečítať."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele dvs. sunt criptate end-to-end. Apple nu le poate citi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai végponttól végpontig titkosítottak. Az Apple nem tudja olvasni."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните ви са криптирани от край до край. Apple не може да ги прочете."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši podaci su šifrirani od kraja do kraja. Apple ih ne može čitati."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα σας είναι κρυπτογραφημένα end-to-end. Η Apple δεν μπορεί να τα διαβάσει."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz uçtan uca şifrelenmiştir. Apple okuyamaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens zijn end-to-end versleuteld. Apple kan ze niet lezen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data er end-to-end-krypteret. Apple kan ikke læse dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina data är end-to-end-krypterade. Apple kan inte läsa dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene dine er ende-til-ende-kryptert. Apple kan ikke lese dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietosi on salattu päästä päähän. Apple ei voi lukea niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda dienkripsi ujung ke ujung. Apple tidak dapat membacanya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda disulitkan hujung-ke-hujung. Apple tidak boleh membacanya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณถูกเข้ารหัสตั้งแต่ต้นทางถึงปลายทาง Apple ไม่สามารถอ่านได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn được mã hóa đầu cuối. Apple không thể đọc được."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yako imesimbwa kwa ukamilifu. Apple haiwezi kuisoma."
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong data ay naka-encrypt mula dulo hanggang dulo. Hindi ito mababasa ng Apple."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vostres dades estan xifrades de punta a punta. Apple no les pot llegir."
          }
        }
      }
    },
    "settings_icloud_hint_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enables encrypted backup to iCloud. Data is end-to-end encrypted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la sauvegarde chiffrée vers iCloud. Données chiffrées de bout en bout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert verschlüsselte Sicherung in iCloud. Daten sind Ende-zu-Ende-verschlüsselt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la copia de seguridad cifrada en iCloud. Datos cifrados de extremo a extremo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il backup crittografato su iCloud. I dati sono crittografati end-to-end."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa backup criptografado no iCloud. Dados criptografados de ponta a ponta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa a cópia encriptada no iCloud. Dados encriptados de ponta a ponta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudへの暗号化バックアップを有効にします。データはエンドツーエンド暗号化されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 암호화된 백업을 활성화합니다. 데이터는 종단 간 암호화됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用iCloud加密备份。数据已端到端加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用iCloud加密備份。資料已端對端加密。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمكين النسخ الاحتياطي المشفر إلى iCloud. البيانات مشفرة من طرف إلى طرف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר גיבוי מוצפן ל-iCloud. הנתונים מוצפנים מקצה לקצה."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال‌سازی پشتیبان رمزنگاری‌شده در iCloud. داده‌ها از سر تا سر رمزنگاری شده‌اند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud پر خفیہ بیک اپ کو فعال کرتا ہے۔ ڈیٹا اینڈ ٹو اینڈ خفیہ ہے۔"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud पर एन्क्रिप्टेड बैकअप सक्षम करता है। डेटा एंड-टू-एंड एन्क्रिप्टेड है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-এ এনক্রিপ্টেড ব্যাকআপ সক্ষম করে। ডেটা এন্ড-টু-এন্ড এনক্রিপ্টেড।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает зашифрованное резервное копирование в iCloud. Данные зашифрованы сквозным шифрованием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає зашифроване резервне копіювання в iCloud. Дані зашифровані наскрізь."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącza zaszyfrowaną kopię zapasową w iCloud. Dane są szyfrowane end-to-end."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolí šifrované zálohování do iCloud. Data jsou šifrována end-to-end."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolí šifrované zálohovanie do iCloud. Dáta sú šifrované end-to-end."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează backup-ul criptat în iCloud. Datele sunt criptate end-to-end."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezi a titkosított biztonsági mentést az iCloudba. Az adatok végponttól végpontig titkosítottak."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Активира криптирано архивиране в iCloud. Данните са криптирани от край до край."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje šifrirano sigurnosno kopiranje u iCloud. Podaci su šifrirani od kraja do kraja."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιεί κρυπτογραφημένο αντίγραφο ασφαλείας στο iCloud. Τα δεδομένα είναι κρυπτογραφημένα end-to-end."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud'a şifreli yedeklemeyi etkinleştirir. Veriler uçtan uca şifrelenmiştir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt versleutelde back-up naar iCloud in. Gegevens zijn end-to-end versleuteld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer krypteret sikkerhedskopiering til iCloud. Data er end-to-end-krypteret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
