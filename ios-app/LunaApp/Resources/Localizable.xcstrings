    "settings_calm_mode_description": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les prédictions pour réduire l'anxiété"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide predictions to reduce anxiety"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء التوقعات لتقليل القلق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen ausblenden, um Angst zu reduzieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar predicciones para reducir la ansiedad"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不安を軽減するために予測を非表示にする"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi le previsioni per ridurre l'ansia"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불안을 줄이기 위해 예측 숨기기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar previsões para reduzir a ansiedade"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ጭንቀትን ለመቀነስ ትንበያዎችን ደብቅ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрийте прогнозите, за да намалите безпокойството"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদ্বেগ কমাতে ভবিষ্যদ্বাণী লুকান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaga les prediccions per reduir l'ansietat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryjte předpovědi, abyste snížili úzkost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul forudsigelser for at reducere angst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη προβλέψεων για μείωση του άγχους"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش بینی ها را برای کاهش اضطراب پنهان کنید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota ennusteet vähentääksesi ahdistusta"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסתר תחזיות כדי להפחית חרדה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चिंता कम करने के लिए भविष्यवाणियाँ छिपाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakrijte predviđanja kako biste smanjili tjeskobu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előrejelzések elrejtése a szorongás csökkentése érdekében"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan prediksi untuk mengurangi kecemasan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembunyikan ramalan untuk mengurangkan kebimbangan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul spådommer for å redusere angst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberg voorspellingen om angst te verminderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj prognozy, aby zmniejszyć niepokój"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde previziunile pentru a reduce anxietatea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скройте прогнозы, чтобы уменьшить беспокойство"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryť predpovede na zníženie úzkosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dölj förutsägelser för att minska ångest"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficha utabiri ili kupunguza wasiwasi"
