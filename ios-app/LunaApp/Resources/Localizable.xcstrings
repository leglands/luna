    "bbt_tooltip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your temperature each morning before getting up, at the same time. A rise of 0.2–0.5°C confirms ovulation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure ta température chaque matin avant de te lever, à la même heure. Une hausse de 0,2–0,5°C confirme l'ovulation."
          }
        }
      }
    },
