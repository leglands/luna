            "value": "원하는 만큼 선택하세요 — 나중에 언제든 변경할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quantas quiser — você sempre pode mudar depois"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የፈለጉትን ያህል ይምረጡ — በኋላ ሁልጊዜ ሊለውጡ ይችላሉ"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете колкото искате — винаги можете да промените по-късно"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যতগুলো চান বেছে নিন — আপনি পরে সবসময় পরিবর্তন করতে পারবেন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria tantes com vulguis — sempre ho pots canviar més tard"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si kolik chcete — vždy to můžete změnit později"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg så mange du vil — du kan altid ændre det senere"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε όσα θέλετε — μπορείτε πάντα να τα αλλάξετε αργότερα"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هرچقدر می‌خواهید انتخاب کنید — همیشه می‌توانید بعداً تغییر دهید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse niin monta kuin haluat — voit aina muuttaa myöhemmin"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר/י כמה שתרצה — אפשר תמיד לשנות אחר כך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितने चाहें उतने चुनें — आप इसे बाद में कभी भी बदल सकते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koliko želite — uvijek možete promijeniti kasnije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz amennyit szeretnél — bármikor megváltoztathatod"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih sebanyak yang Anda mau — Anda selalu bisa mengubahnya nanti"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih seberapa banyak yang anda mahu — anda boleh ubah kemudian"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg så mange du vil — du kan alltid endre det senere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er zoveel als je wilt — je kunt dit altijd later wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tyle, ile chcesz — zawsze możesz to zmienić później"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege câte vrei — poți schimba oricând"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте сколько хотите — вы всегда сможете изменить это позже"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si koľko chcete — vždy to môžete zmeniť neskôr"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj så många du vill — du kan alltid ändra detta senare"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua unavyopenda — unaweza kubadilisha baadaye"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกกี่ข้อก็ได้ — คุณเปลี่ยนได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğiniz kadar seçin — her zaman değiştirebilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обирайте скільки хочете — ви завжди зможете змінити це пізніше"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جتنے چاہیں منتخب کریں — آپ بعد میں ہمیشہ تبدیل کر سکتے ہیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn bao nhiêu tùy thích — bạn luôn có thể thay đổi sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择任意多个 — 您随时可以更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇任意多個 — 您隨時可以更改"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Khetha ngokuningi ngendlela ofisa ngayo — ungakushintsha nganoma nini"
          }
        }
      }
    },
