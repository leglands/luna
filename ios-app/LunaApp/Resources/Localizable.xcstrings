    "insight_sample_luteal_cramps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramps are common in the luteal phase. Try gentle stretching or a warm compress."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crampes sont fréquentes en phase lutéale. Essayez des étirements doux ou une compresse chaude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Krämpfe sind in der Lutealphase häufig. Versuche sanftes Dehnen oder eine warme Kompresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calambres son comunes en la fase lútea. Prueba estiramientos suaves o una compresa caliente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crampi sono comuni nella fase luteale. Prova stretching leggero o un impacco caldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cólicas são comuns na fase lútea. Tente alongamentos suaves ou uma compressa quente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黄体期にはけいれんがよく起こります。やさしいストレッチや温湿布を試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황체기에는 경련이 흔합니다. 가벼운 스트레칭이나 온찜질을 해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄体期痉挛很常见。试试轻柔的伸展或热敷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黃體期痙攣很常見。試試輕柔的伸展或熱敷。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشنجات شائعة في المرحلة الأصفرية. جربي التمدد اللطيف أو كمادة دافئة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוויתות נפוצות בשלב הלוטאלי. נסי מתיחות עדינות או קומפרס חם."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گرفتگی در فاز لوتئال رایج است. کشش ملایم یا کمپرس گرم را امتحان کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ल्यूटियल चरण में ऐंठन आम है। हल्के स्ट्रेचिंग या गर्म सेक आज़माएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুটেয়াল পর্যায়ে খিঁচুনি সাধারণ। হালকা স্ট্রেচিং বা গরম সেঁক চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لیوٹیل مرحلے میں درد عام ہے۔ ہلکی اسٹریچنگ یا گرم سینک آزمائیں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судороги типичны для лютеиновой фазы. Попробуйте лёгкую растяжку или тёплый компресс."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Судоми типові для лютеїнової фази. Спробуйте легку розтяжку або теплий компрес."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skurcze są częste w fazie lutealnej. Spróbuj delikatnego rozciągania lub ciepłego kompresu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Křeče jsou v luteální fázi běžné. Zkus jemné protahování nebo teplý obklad."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kŕče sú v luteálnej fáze bežné. Skús jemné naťahovanie alebo teplý obklad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A görcsök gyakoriak a luteális fázisban. Próbálj enyhe nyújtást vagy meleg borogatást."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crampele sunt frecvente în faza luteală. Încearcă stretching ușor sau o compresă caldă."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Крампите са чести в лутеалната фаза. Опитайте леко разтягане или топъл компрес."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grčevi su česti u lutealnoj fazi. Pokušajte s blagim istezanjem ili toplim oblogom."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κράμπες είναι συχνές στη ωχρινική φάση. Δοκιμάστε απαλό στρέτσινγκ ή ζεστή κομπρέσα."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Luteal fazda kramplar yaygındır. Hafif esneme veya sıcak kompres deneyin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper er almindelige i lutealfasen. Prøv blid udstrækning eller en varm kompres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper är vanliga i lutealfasen. Prova lätt stretching eller en varm kompress."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kramper er vanlige i lutealfasen. Prøv lett tøying eller en varm kompress."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kouristukset ovat yleisiä luteaalivaiheessa. Kokeile kevyttä venyttelyä tai lämmintä hauetta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krampen komen vaak voor in de luteale fase. Probeer zachte stretching of een warm kompres."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els rampes són freqüents en la fase luteínica. Prova estiraments suaus o una compresa calenta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kram umum terjadi pada fase luteal. Coba peregangan ringan atau kompres hangat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekejangan biasa berlaku dalam fasa luteal. Cuba regangan ringan atau kompres hangat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตะคริวพบบ่อยในช่วงลูเทียล ลองยืดตัวเบาๆ หรือประคบร้อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột rút phổ biến trong giai đoạn hoàng thể. Hãy thử kéo giãn nhẹ hoặc chườm nóng."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maumivu ya tumbo ni ya kawaida katika awamu ya luteal. Jaribu mazoezi ya upole au kitambaa cha joto."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሉቲያል ምዕራፍ ውስጥ ቅርጫት የተለመደ ነው። ቀላል ተዘርጋ ወይም ሞቅ ያለ ማጠቢያ ሞክሩ።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinhlungu zivamile esigabeni seluteal. Zama ukwelula okumnene noma i-compress eshisayo."
          }
        }
      }
    },
