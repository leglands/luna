          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverer kryptert sikkerhetskopiering til iCloud. Data er ende-til-ende-kryptert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottaa käyttöön salatun varmuuskopioinnin iCloudiin. Tiedot on salattu päästä päähän."
          }
        },
        "id": {
          "stringUnit": {
