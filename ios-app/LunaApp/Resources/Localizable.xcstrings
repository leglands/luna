    "article_perimenopause_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irregular cycles, hot flashes, and mood changes are common. Tracking helps identify patterns."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cycles irréguliers, bouffées de chaleur et sautes d'humeur sont courants. Le suivi aide à identifier les tendances."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unregelmäßige Zyklen, Hitzewallungen und Stimmungsschwankungen sind häufig. Das Tracking hilft, Muster zu erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos irregulares, sofocos y cambios de humor son comunes. El seguimiento ayuda a identificar patrones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cicli irregolari, vampate e cambiamenti d'umore sono comuni. Il monitoraggio aiuta a identificare i pattern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos irregulares, ondas de calor e mudanças de humor são comuns. O acompanhamento ajuda a identificar padrões."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不規則な周期、ほてり、気分の変化はよくあります。記録するとパターンが見えてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불규칙한 주기, 안면홍조, 기분 변화가 흔합니다. 추적하면 패턴을 파악할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不规则周期、潮热和情绪变化很常见。记录有助于识别模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不規則週期、潮熱和情緒變化很常見。記錄有助於識別模式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدورات غير المنتظمة والهبات الساخنة وتغيرات المزاج شائعة. التتبع يساعد في تحديد الأنماط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזורים לא סדירים, גלי חום ושינויי מצב רוח נפוצים. מעקב עוזר לזהות דפוסים."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چرخه‌های نامنظم، گُر گرفتگی و تغییرات خلقی رایج هستند. پیگیری به شناسایی الگوها کمک می‌کند."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनियमित चक्र, गर्म लहरें और मूड में बदलाव आम हैं। ट्रैकिंग से पैटर्न पहचानने में मदद मिलती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনিয়মিত চক্র, হট ফ্ল্যাশ এবং মেজাজ পরিবর্তন সাধারণ। ট্র্যাকিং প্যাটার্ন সনাক্ত করতে সাহায্য করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بے قاعدہ سائیکل، گرم فلیشز اور موڈ میں تبدیلیاں عام ہیں۔ ٹریکنگ پیٹرن کی شناخت میں مدد کرتی ہے۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нерегулярные циклы, приливы жара и перепады настроения — обычное дело. Отслеживание помогает выявить закономерности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нерегулярні цикли, припливи жару та зміни настрою — звичайне явище. Відстеження допомагає виявити закономірності."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieregularne cykle, uderzenia gorąca i zmiany nastroju są częste. Śledzenie pomaga zidentyfikować wzorce."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravidelné cykly, návaly horka a změny nálad jsou běžné. Sledování pomáhá identifikovat vzorce."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepravidelné cykly, návaly horúčavy a zmeny nálad sú bežné. Sledovanie pomáha identifikovať vzorce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az irreguláris ciklusok, hőhullámok és hangulatingadozások gyakoriak. A követés segít a minták felismerésében."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclurile neregulate, bufeurile și schimbările de dispoziție sunt frecvente. Urmărirea ajută la identificarea tiparelor."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нередовните цикли, горещите вълни и промените в настроението са чести. Проследяването помага за идентифициране на модели."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredoviti ciklusi, valovi vrućine i promjene raspoloženja su česti. Praćenje pomaže prepoznati obrasce."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακανόνιστοι κύκλοι, εξάψεις και αλλαγές διάθεσης είναι συχνές. Η παρακολούθηση βοηθά στον εντοπισμό μοτίβων."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzensiz döngüler, sıcak basmaları ve ruh hali değişiklikleri yaygındır. Takip, kalıpları belirlemeye yardımcı olur."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uregelmæssige cyklusser, hedeture og humørsvingninger er almindelige. Sporing hjælper med at identificere mønstre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oregelbundna cykler, värmevallningar och humörförändringar är vanliga. Spårning hjälper att identifiera mönster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uregelmessige sykluser, hetetokter og humørsvingninger er vanlige. Sporing hjelper med å identifisere mønstre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Epäsäännölliset kierrot, kuumat aallot ja mielialanvaihtelut ovat yleisiä. Seuranta auttaa tunnistamaan kaavoja."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onregelmatige cycli, opvliegers en stemmingswisselingen zijn gebruikelijk. Tracking helpt patronen te herkennen."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els cicles irregulars, les onades de calor i els canvis d'humor són freqüents. El seguiment ajuda a identificar patrons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siklus tidak teratur, hot flash, dan perubahan suasana hati umum terjadi. Pelacakan membantu mengidentifikasi pola."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaran tidak teratur, kepanasan dan perubahan mood adalah biasa. Penjejakan membantu mengenal pasti corak."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบเดือนไม่สม่ำเสมอ อาการร้อนวูบวาบ และอารมณ์เปลี่ยนแปลงเป็นเรื่องปกติ การติดตามช่วยระบุรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ không đều, bốc hỏa và thay đổi tâm trạng là phổ biến. Theo dõi giúp nhận diện các mẫu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mizunguko isiyo ya kawaida, joto la ghafla na mabadiliko ya hali ya hewa ni ya kawaida. Ufuatiliaji husaidia kutambua mifumo."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የማይታወቁ ዑደቶች፣ ሙቀት ማግበስ እና የስሜት ለውጦች የተለመዱ ናቸው። ክትትል ንድፎችን ለመለየት ይረዳል።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Imijikelezo engajwayelekile, ukushisa okuphazamisayo kanye nezinguquko zomoya kuvamile. Ukulandelela kusiza ukubona amaphethini."
          }
        }
      }
    },
