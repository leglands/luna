    "notif_period_body": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez-vous, les règles sont attendues dans 2 jours."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get ready, your period is expected in 2 days."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparati, il tuo ciclo è previsto tra 2 giorni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비하세요. 생리는 2일 후에 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-se, sua menstruação está prevista para daqui a 2 dias."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ተዘጋጅ፣ የወር አበባህ በ2 ቀናት ውስጥ ይጠበቃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعدي، فمن المتوقع أن تأتي دورتك الشهرية بعد يومين."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пригответе се, цикълът ви се очаква след 2 дни."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তুত হন, আপনার মাসিক 2 দিনের মধ্যে প্রত্যাশিত।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara't, el teu període s'espera en 2 dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připravte se, menstruace se očekává za 2 dny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bliv klar, din menstruation forventes om 2 dage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie sich bereit, Ihre Periode wird in 2 Tagen erwartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ετοιμαστείτε, η περίοδός σας αναμένεται σε 2 ημέρες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepárate, tu período se espera en 2 días."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده شوید، قاعدگی شما تا 2 روز دیگر پیش بینی می شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistaudu, kuukautisten odotetaan alkavan 2 päivän kuluttua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תתכונן, המחזור שלך צפוי בעוד יומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार हो जाइए, आपका मासिक धर्म 2 दिनों में आने वाला है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremite se, menstruacija se očekuje za 2 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készülj fel, 2 nap múlva várható a menstruációd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersiaplah, menstruasi Anda diperkirakan dalam 2 hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理予定日は 2 日です。準備をしてください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersedia, tempoh anda dijangka dalam 2 hari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør deg klar, mensen forventes om 2 dager."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je klaar, je menstruatie wordt over 2 dagen verwacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotuj się, miesiączka spodziewana jest za 2 dni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătește-te, menstruația este așteptată în 2 zile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готовьтесь, менструация ожидается через 2 дня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripravte sa, menštruácia sa očakáva o 2 dni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör dig redo, din mens väntas om 2 dagar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jitayarishe, kipindi chako kinatarajiwa baada ya siku 2."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เตรียมตัวให้พร้อม ประจำเดือนมาในอีก 2 วัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olun, adetinizin 2 gün sonra olması bekleniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готуйтеся, місячні очікуються через 2 дні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تیار ہو جائیں، آپ کی مدت 2 دنوں میں متوقع ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sẵn sàng, kỳ kinh của bạn sẽ diễn ra sau 2 ngày nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做好准备，预计 2 天后就会来月经。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做好準備，預計 2 天後就會來月經。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zilungiselele, isikhathi sakho silindelwe ezinsukwini ezi-2."
          }
        }
      }
    },
