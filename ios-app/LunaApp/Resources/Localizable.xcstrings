    "onboarding_welcome_subtitle": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cycle, vos données, votre espace. Tout reste sur votre téléphone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cycle, your data, your space. Everything stays on your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورتك، بياناتك، مساحتك. كل شيء يبقى على هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Zyklus, Ihre Daten, Ihr Bereich. Alles bleibt auf Ihrem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ciclo, tus datos, tu espacio. Todo permanece en tu teléfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの周期、あなたのデータ、あなたの空間。すべてお使いの端末に安全に保存されます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ciclo, i tuoi dati, il tuo spazio. Tutto resta sul tuo telefono."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 주기, 당신의 데이터, 당신의 공간. 모든 것이 휴대폰에만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ciclo, seus dados, seu espaço. Tudo fica no seu celular."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የእርስዎ ዑደት፣ የእርስዎ ውሂብ፣ የእርስዎ ቦታ። ሁሉም በስልክዎ ላይ ይቆያል።"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашият цикъл, вашите данни, вашето пространство. Всичко остава на телефона ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার চক্র, আপনার ডেটা, আপনার স্থান। সবকিছু আপনার ফোনেই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu cicle, les teves dades, el teu espai. Tot es queda al teu telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš cyklus, vaše data, váš prostor. Vše zůstává ve vašem telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cyklus, dine data, dit rum. Alt forbliver på din telefon."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κύκλος σας, τα δεδομένα σας, ο χώρος σας. Όλα μένουν στο τηλέφωνό σας."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چرخه شما، داده‌های شما، فضای شما. همه چیز روی گوشی شما می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun kiertosi, sinun tietosi, sinun tilasi. Kaikki pysyy puhelimessasi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחזור שלך, הנתונים שלך, המרחב שלך. הכל נשאר בטלפון שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका चक्र, आपका डेटा, आपका स्थान। सब कुछ आपके फ़ोन पर रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš ciklus, vaši podaci, vaš prostor. Sve ostaje na vašem telefonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A te ciklusod, a te adataid, a te tered. Minden a telefonodon marad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siklus Anda, data Anda, ruang Anda. Semuanya tetap di ponsel Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaran anda, data anda, ruang anda. Semuanya kekal di telefon anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din syklus, dine data, ditt rom. Alt forblir på telefonen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw cyclus, jouw gegevens, jouw ruimte. Alles blijft op je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój cykl, twoje dane, twoja przestrzeń. Wszystko zostaje na twoim telefonie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclul tău, datele tale, spațiul tău. Totul rămâne pe telefonul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш цикл, ваши данные, ваше пространство. Всё остаётся на вашем телефоне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš cyklus, vaše údaje, váš priestor. Všetko zostáva vo vašom telefóne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cykel, dina data, ditt utrymme. Allt stannar på din telefon."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mzunguko wako, data yako, nafasi yako. Kila kitu kinabaki kwenye simu yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วงจรของคุณ ข้อมูลของคุณ พื้นที่ของคุณ ทุกอย่างอยู่ในโทรศัพท์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döngünüz, verileriniz, alanınız. Her şey telefonunuzda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш цикл, ваші дані, ваш простір. Все залишається на вашому телефоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا سائیکل، آپ کا ڈیٹا، آپ کی جگہ۔ سب کچھ آپ کے فون پر رہتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ của bạn, dữ liệu của bạn, không gian của bạn. Mọi thứ ở ngay trên điện thoại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的周期，您的数据，您的空间。一切都留在您的手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的週期，您的資料，您的空間。一切都留在您的手機上。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Isigaba sakho, idatha yakho, indawo yakho. Konke kuhlala efonini yakho."
          }
        }
      }
    },
