    "welcome_subtitle_privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private space is ready. Everything is encrypted and stays right here on your phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre espace privé est prêt. Tout est chiffré et reste ici, sur votre téléphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr privater Bereich ist bereit. Alles ist verschlüsselt und bleibt hier auf Ihrem Telefon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu espacio privado está listo. Todo está cifrado y permanece aquí, en tu teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo spazio privato è pronto. Tutto è crittografato e resta qui, sul tuo telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu espaço privado está pronto. Tudo está criptografado e fica aqui, no seu celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベート空間の準備ができました。すべて暗号化され、お使いの端末に安全に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 공간이 준비되었습니다. 모든 것이 암호화되어 휴대폰에만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的私人空间已就绪。一切已加密，安全存储在您的手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的私人空間已就緒。一切已加密，安全儲存在您的手機上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحتك الخاصة جاهزة. كل شيء مشفّر ويبقى هنا على هاتفك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше личное пространство готово. Всё зашифровано и остаётся здесь, на вашем телефоне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel alanınız hazır. Her şey şifrelenmiş ve telefonunuzda kalıyor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je privéruimte is klaar. Alles is versleuteld en blijft hier op je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja prywatna przestrzeń jest gotowa. Wszystko jest zaszyfrowane i zostaje na twoim telefonie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका निजी स्थान तैयार है। सब कुछ एन्क्रिप्टेड है और आपके फ़ोन पर ही रहता है।"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt privata utrymme är klart. Allt är krypterat och stannar här på din telefon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit private rum er klar. Alt er krypteret og forbliver her på din telefon."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt private rom er klart. Alt er kryptert og forblir her på telefonen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityinen tilasi on valmis. Kaikki on salattu ja pysyy täällä puhelimessasi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš soukromý prostor je připraven. Vše je šifrováno a zůstává zde ve vašem telefonu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš súkromný priestor je pripravený. Všetko je šifrované a zostáva tu vo vašom telefóne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A privát tered készen áll. Minden titkosított és itt marad a telefonodon."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul tău privat este gata. Totul e criptat și rămâne aici, pe telefonul tău."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš privatni prostor je spreman. Sve je šifrirano i ostaje ovdje na vašem telefonu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашето лично пространство е готово. Всичко е криптирано и остава тук на телефона ви."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ιδιωτικός σας χώρος είναι έτοιμος. Όλα είναι κρυπτογραφημένα και μένουν εδώ στο τηλέφωνό σας."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרחב הפרטי שלך מוכן. הכל מוצפן ונשאר כאן בטלפון שלך."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای خصوصی شما آماده است. همه چیز رمزگذاری شده و در گوشی شما باقی می‌ماند."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی نجی جگہ تیار ہے۔ سب کچھ خفیہ ہے اور آپ کے فون پر ہی رہتا ہے۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ব্যক্তিগত স্থান প্রস্তুত। সবকিছু এনক্রিপ্ট করা এবং আপনার ফোনেই থাকে।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ส่วนตัวของคุณพร้อมแล้ว ทุกอย่างถูกเข้ารหัสและอยู่ในโทรศัพท์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian riêng tư của bạn đã sẵn sàng. Mọi thứ được mã hóa và ở ngay trên điện thoại của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang pribadi Anda siap. Semuanya terenkripsi dan tetap di ponsel Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang peribadi anda sedia. Semuanya disulitkan dan kekal di telefon anda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafasi yako ya faragha iko tayari. Kila kitu kimesimbwa na kinabaki hapa kwenye simu yako."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu espai privat és a punt. Tot està xifrat i es queda aquí, al teu telèfon."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш приватний простір готовий. Все зашифровано і залишається тут, на вашому телефоні."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የግል ቦታዎ ዝግጁ ነው። ሁሉም ነገር ተመስጥሮ በስልክዎ ላይ ይቆያል።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indawo yakho eyimfihlo isikulungele. Konke kubethelwe futhi kuhlala lapha efonini yakho."
          }
        }
      }
    },
