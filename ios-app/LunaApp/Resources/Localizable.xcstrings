    "article_ovulation_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for cervical mucus changes, mild pelvic pain, and a slight rise in basal body temperature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez les changements de glaire cervicale, une légère douleur pelvienne et une légère hausse de la température basale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf Veränderungen des Zervixschleims, leichte Beckenschmerzen und einen leichten Anstieg der Basaltemperatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe los cambios en el moco cervical, dolor pélvico leve y un ligero aumento de la temperatura basal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva i cambiamenti del muco cervicale, un lieve dolore pelvico e un leggero aumento della temperatura basale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observe mudanças no muco cervical, dor pélvica leve e um ligeiro aumento na temperatura basal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頸管粘液の変化、軽い骨盤痛、基礎体温のわずかな上昇に注目してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자궁경부 점액 변화, 가벼운 골반통, 기초체온의 약간의 상승을 관찰하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意宫颈粘液变化、轻微盆腔疼痛和基础体温的轻微升高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "注意子宮頸黏液變化、輕微骨盆疼痛和基礎體溫的輕微升高。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راقبي تغيرات مخاط عنق الرحم وألم الحوض الخفيف وارتفاع طفيف في درجة حرارة الجسم الأساسية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימי לב לשינויים בריר צוואר הרחם, כאב אגן קל ועלייה קלה בטמפרטורה הבסיסית."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به تغییرات مخاط دهانه رحم، درد خفیف لگن و افزایش جزئی دمای پایه بدن توجه کنید."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वाइकल म्यूकस में बदलाव, हल्के पेल्विक दर्द और बेसल बॉडी टेम्परेचर में मामूली वृद्धि पर ध्यान दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভিকাল শ্লেষ্মার পরিবর্তন, হালকা পেলভিক ব্যথা এবং বেসাল শরীরের তাপমাত্রায় সামান্য বৃদ্ধি লক্ষ্য করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سروائیکل بلغم میں تبدیلیاں، ہلکا شرونیی درد اور بنیادی جسمانی درجہ حرارت میں معمولی اضافے پر نظر رکھیں۔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за изменениями цервикальной слизи, лёгкой тазовой болью и небольшим повышением базальной температуры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідкуйте за змінами цервікального слизу, легким тазовим болем та невеликим підвищенням базальної температури."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj zmiany śluzu szyjkowego, łagodny ból miednicy i lekki wzrost temperatury bazowej."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj změny cervikálního hlenu, mírnou pánevní bolest a mírný vzestup bazální teploty."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj zmeny cervikálneho hlienu, miernu panvovú bolesť a mierny nárast bazálnej teploty."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyeld a méhnyak-nyák változásait, az enyhe medencecsont-fájdalmat és a bazális testhőmérséklet enyhe emelkedését."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește modificările mucusului cervical, durerea pelvină ușoară și o ușoară creștere a temperaturii bazale."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Следете за промени в цервикалната слуз, лека тазова болка и леко повишаване на базалната температура."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratite promjene cervikalne sluzi, blagu zdjeličnu bol i blagi porast bazalne temperature."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε αλλαγές στη βλέννα του τραχήλου, ήπιο πυελικό πόνο και ελαφρά αύξηση της βασικής θερμοκρασίας."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servikal mukus değişikliklerini, hafif pelvik ağrıyı ve bazal vücut sıcaklığında hafif artışı izleyin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold øje med ændringer i livmoderhalsslimet, milde bækkensmerter og en let stigning i basaltemperaturen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se efter förändringar i livmoderhalssekretet, mild bäckensmärta och en lätt ökning av basaltemperaturen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se etter endringer i livmorhalsslimet, milde bekkensmerter og en lett stigning i basaltemperaturen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkkaile kohdunkaulan liman muutoksia, lievää lantiokipua ja peruslämpötilan lievää nousua."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Let op veranderingen in baarmoederhalslijm, milde bekkenboordpijn en een lichte stijging van de basale temperatuur."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa els canvis en el moc cervical, dolor pèlvic lleu i un lleuger augment de la temperatura basal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perhatikan perubahan lendir serviks, nyeri panggul ringan, dan sedikit kenaikan suhu tubuh basal."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perhatikan perubahan lendir serviks, sakit pelvis ringan, dan sedikit kenaikan suhu badan basal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สังเกตการเปลี่ยนแปลงของมูกปากมดลูก อาการปวดอุ้งเชิงกรานเล็กน้อย และอุณหภูมิพื้นฐานเพิ่มขึ้นเล็กน้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chú ý sự thay đổi dịch nhầy cổ tử cung, đau vùng chậu nhẹ và nhiệt độ cơ thể cơ bản tăng nhẹ."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Angalia mabadiliko ya kamasi ya shingo ya kizazi, maumivu ya pelvis ya kidogo na ongezeko kidogo la joto la msingi la mwili."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የማህጸን ንፋጥ ለውጦች፣ ቀላል የጎን አጥንት ህመም እና የመሠረታዊ የሰውነት ሙቀት ትንሽ ከፍ ማለት ይከታተሉ።"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bheka izinguquko ze-cervical mucus, ubuhlungu obuncane be-pelvic, nokunyuka okuncane kwe-basal body temperature."
          }
        }
      }
    },
