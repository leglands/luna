    "panic_wipe_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently erase all your data. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos données seront effacées définitivement. Impossible d'annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò cancellerà definitivamente tutti i tuoi dati. Questa operazione non può essere annullata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 모든 데이터가 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apagará permanentemente todos os seus dados. Isto não pode ser desfeito."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ሁሉንም ውሂብዎን እስከመጨረሻው ይሰርዘዋል። ይህ ሊቀለበስ አይችልም።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى محو جميع بياناتك بشكل دائم. لا يمكن التراجع عن هذا."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще изтрие завинаги всичките ви данни. Това не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার সমস্ত ডেটা স্থায়ীভাবে মুছে ফেলবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això esborrarà permanentment totes les teves dades. Això no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím trvale vymažete všechna vaše data. Toto nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil permanent slette alle dine data. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Ihre Daten dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα διαγράψει οριστικά όλα τα δεδομένα σας. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará permanentemente todos sus datos. Esto no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کار تمام داده های شما برای همیشه پاک می شود. این قابل واگرد نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaikki tietosi. Tätä ei voi kumota."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק לצמיתות את כל הנתונים שלך. לא ניתן לבטל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपका सारा डेटा स्थायी रूप से मिट जाएगा. इसे असंपादित नहीं किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će trajno izbrisati sve vaše podatke. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel véglegesen törli az összes adatot. Ezt nem lehet visszavonni."
