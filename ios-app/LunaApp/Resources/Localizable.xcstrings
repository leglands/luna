    "perimeno.info_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause is a natural transition. Cycle length variability is expected. Track your symptoms to identify patterns and discuss them with your healthcare provider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perimenopause is a natural transition. Cycle length variability is expected. Track your symptoms to identify patterns and discuss them with your healthcare provider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La perimenopausa è una transizione naturale. È prevista variabilità nella durata del ciclo. Tieni traccia dei tuoi sintomi per identificare i modelli e discuterli con il tuo medico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폐경기 전후는 자연스러운 전환입니다. 주기 길이의 가변성이 예상됩니다. 증상을 추적하여 패턴을 식별하고 의료 서비스 제공자와 논의하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perimenopausa é uma transição natural. A variabilidade da duração do ciclo é esperada. Acompanhe seus sintomas para identificar padrões e discuta-os com seu médico."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፐርሜኖፓዝ ተፈጥሯዊ ሽግግር ነው. የዑደት ርዝመት ተለዋዋጭነት ይጠበቃል። ምልክቶችን ለመለየት ምልክቶችዎን ይከታተሉ እና ከጤና እንክብካቤ አቅራቢዎ ጋር ይወያዩ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فترة انقطاع الطمث هي مرحلة انتقالية طبيعية. ومن المتوقع تقلب طول الدورة. تتبع أعراضك لتحديد الأنماط ومناقشتها مع مقدم الرعاية الصحية الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Перименопаузата е естествен преход. Очаква се променливост на продължителността на цикъла. Проследявайте симптомите си, за да идентифицирате модели и ги обсъдете с вашия доставчик на здравни услуги."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেরিমেনোপজ একটি প্রাকৃতিক পরিবর্তন। চক্র দৈর্ঘ্য পরিবর্তনশীলতা প্রত্যাশিত. প্যাটার্নগুলি সনাক্ত করতে আপনার লক্ষণগুলি ট্র্যাক করুন এবং আপনার স্বাস্থ্যসেবা প্রদানকারীর সাথে সেগুলি নিয়ে আলোচনা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La perimenopausa és una transició natural. S'espera una variabilitat de la durada del cicle. Feu un seguiment dels vostres símptomes per identificar patrons i discutiu-los amb el vostre proveïdor d'atenció mèdica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopauza je přirozený přechod. Očekává se variabilita délky cyklu. Sledujte své příznaky, abyste identifikovali vzorce a prodiskutujte je se svým poskytovatelem zdravotní péče."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause er en naturlig overgang. Cykluslængdevariation forventes. Spor dine symptomer for at identificere mønstre og diskuter dem med din sundhedsplejerske."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Perimenopause ist ein natürlicher Übergang. Schwankungen der Zykluslänge sind zu erwarten. Verfolgen Sie Ihre Symptome, um Muster zu erkennen und besprechen Sie diese mit Ihrem Arzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περιεμμηνόπαυση είναι μια φυσική μετάβαση. Αναμένεται μεταβλητότητα μήκους κύκλου. Παρακολουθήστε τα συμπτώματά σας για να εντοπίσετε μοτίβα και να τα συζητήσετε με τον πάροχο υγειονομικής περίθαλψης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La perimenopausia es una transición natural. Se espera variabilidad en la duración del ciclo. Realice un seguimiento de sus síntomas para identificar patrones y discútalos con su proveedor de atención médica."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از یائسگی یک انتقال طبیعی است. تغییر طول چرخه مورد انتظار است. علائم خود را برای شناسایی الگوها دنبال کنید و آنها را با ارائه دهنده مراقبت های بهداشتی خود در میان بگذارید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopaussi on luonnollinen siirtymävaihe. Jakson pituuden vaihtelua odotetaan. Seuraa oireitasi tunnistaaksesi malleja ja keskustele niistä terveydenhuollon tarjoajan kanssa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תקופת המנופאוזה היא מעבר טבעי. צפויה שינויים באורך המחזור. עקוב אחר הסימפטומים שלך כדי לזהות דפוסים ולדון בהם עם ספק שירותי הבריאות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेरीमेनोपॉज़ एक प्राकृतिक संक्रमण है। चक्र लंबाई परिवर्तनशीलता अपेक्षित है. पैटर्न की पहचान करने के लिए अपने लक्षणों को ट्रैक करें और अपने स्वास्थ्य सेवा प्रदाता के साथ उन पर चर्चा करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopauza je prirodni prijelaz. Očekuje se varijabilnost duljine ciklusa. Pratite svoje simptome kako biste identificirali uzorke i razgovarali o njima sa svojim liječnikom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A perimenopauza természetes átmenet. A ciklushossz változékonysága várható. Kövesse nyomon a tüneteit a minták azonosításához, és beszélje meg őket egészségügyi szolgáltatójával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause adalah transisi alami. Variabilitas panjang siklus diharapkan. Lacak gejala Anda untuk mengidentifikasi polanya dan diskusikan dengan penyedia layanan kesehatan Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉経周辺期は自然な移行期です。周期長の変動が予想されます。症状を追跡してパターンを特定し、医療提供者と話し合ってください。"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause adalah peralihan semula jadi. Kebolehubahan panjang kitaran dijangka. Jejaki simptom anda untuk mengenal pasti corak dan bincangkannya dengan pembekal penjagaan kesihatan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause er en naturlig overgang. Variasjon i sykluslengden forventes. Spor symptomene dine for å identifisere mønstre og diskuter dem med helsepersonell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De perimenopauze is een natuurlijke overgang. Variatie in de cycluslengte wordt verwacht. Volg uw symptomen om patronen te identificeren en bespreek deze met uw zorgverlener."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopauza to naturalny proces przejściowy. Oczekuje się zmienności długości cyklu. Śledź swoje objawy, aby zidentyfikować wzorce i omów je ze swoim lekarzem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopauza este o tranziție naturală. Este de așteptat variabilitatea duratei ciclului. Urmăriți-vă simptomele pentru a identifica tiparele și discutați-le cu furnizorul de asistență medicală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перименопауза – это естественный переход. Ожидается изменчивость длины цикла. Отслеживайте свои симптомы, чтобы выявить закономерности, и обсудите их со своим лечащим врачом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopauza je prirodzený prechod. Očakáva sa variabilita dĺžky cyklu. Sledujte svoje príznaky, aby ste identifikovali vzorce a prediskutujte ich so svojím poskytovateľom zdravotnej starostlivosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause är en naturlig övergång. Variation i cykellängden förväntas. Spåra dina symtom för att identifiera mönster och diskutera dem med din vårdgivare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause ni mpito wa asili. Tofauti ya urefu wa mzunguko inatarajiwa. Fuatilia dalili zako ili kutambua mwelekeo na ujadiliane na mtoa huduma wako wa afya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วัยใกล้หมดประจำเดือนเป็นการเปลี่ยนแปลงตามธรรมชาติ คาดว่าจะมีความแปรปรวนของความยาวรอบเดือน ติดตามอาการของคุณเพื่อระบุรูปแบบและหารือกับผู้ให้บริการด้านการดูแลสุขภาพของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopoz doğal bir geçiştir. Döngü uzunluğu değişkenliği bekleniyor. Kalıpları belirlemek için belirtilerinizi takip edin ve bunları sağlık uzmanınızla görüşün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перименопауза є природним переходом. Очікується мінливість тривалості циклу. Відстежуйте свої симптоми, щоб визначити закономірності та обговоріть їх зі своїм лікарем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Perimenopause ایک قدرتی منتقلی ہے۔ سائیکل کی لمبائی میں تغیر متوقع ہے۔ نمونوں کی شناخت کے لیے اپنے علامات کو ٹریک کریں اور اپنے ہیلتھ کیئر فراہم کنندہ سے ان پر بات کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiền mãn kinh là một quá trình chuyển đổi tự nhiên. Sự thay đổi độ dài chu kỳ được mong đợi. Theo dõi các triệu chứng của bạn để xác định các mẫu và thảo luận chúng với nhà cung cấp dịch vụ chăm sóc sức khỏe của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "围绝经期是一个自然的过渡期。周期长度的变化是预期的。跟踪您的症状以识别模式并与您的医疗保健提供者讨论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圍絕經期是一個自然的過渡期。週期長度的變化是預期的。追蹤您的症狀以識別模式並與您的醫療保健提供者討論。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-Perimenopause inguquko yemvelo. Ukuhlukahluka kobude bomjikelezo kulindelekile. Landelela izimpawu zakho ukuze ubone amaphethini futhi uxoxe ngazo nomhlinzeki wakho wezempilo."
          }
        }
      }
    },
