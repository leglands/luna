<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/luna_neutral_50"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/luna_neutral_50"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_app_bar"
            style="@style/Luna.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:subtitle="@string/toolbar_private_subtitle"
            app:title="@string/tab_settings" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_privacy"
                android:textAppearance="@style/Luna.Text.H4" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/luna_neutral_0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/luna_neutral_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tracking_mode_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/settings_tracking_mode"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_luna_user"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/panic_wipe_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/settings_delete_all_label"
                        android:textColor="@color/luna_status_danger"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_luna_lock"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/luna_status_danger"
                        app:strokeColor="@color/luna_status_danger" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_section_tracking"
                android:textAppearance="@style/Luna.Text.H4" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/luna_neutral_0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/luna_neutral_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_daily_notif"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/notif_daily_log_label" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_period_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/notif_period_reminder_label" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_fertile_window"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/notif_fertile_window_label" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_pill_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/settings_pill_reminder" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_section_data"
                android:textAppearance="@style/Luna.Text.H4" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/luna_neutral_0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/luna_neutral_200"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/export_csv_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/export_csv_label"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_luna_calendar"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/export_backup_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/export_encrypted_backup_label"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_luna_lock"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restore_backup_button"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/restore_encrypted_backup_label"
                        app:cornerRadius="18dp"
                        app:icon="@drawable/ic_luna_shield"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
