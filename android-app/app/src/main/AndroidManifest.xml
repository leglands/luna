<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Biométrie -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Notifications locales (WorkManager) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ZÉRO permissions réseau — aucun ACCESS_NETWORK_STATE ni INTERNET -->

    <!-- Health Connect (opt-in explicite, service API 26+) — parité iOS HealthKit :
         écriture du flux menstruel, lecture du flux menstruel + température basale.
         Aucune autre permission santé ; données locales, aucun envoi serveur. -->
    <uses-permission android:name="android.permission.health.WRITE_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" />

    <!-- Visibilité du package Health Connect (API 30+) pour HealthConnectClient.getSdkStatus(). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- life-ds (com.macaron.lifeds) déclare minSdk 26 ; Luna garde minSdk 23 (desugaring activé).
         Le DS est du Compose pur (aucune API 26 obligatoire au runtime sur API 23-25). -->
    <uses-sdk tools:overrideLibrary="com.macaron.lifeds,androidx.health.connect.client" />

    <application
        android:name=".LunaApplication"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Luna"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!-- Désactiver tout accès réseau par configuration -->

        <!-- MainActivity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|fontScale" />

        <!-- LockActivity — écran de déverrouillage -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:theme="@style/Theme.Luna.Lock"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OnboardingActivity -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|fontScale" />

        <!-- SettingsActivity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="locale|layoutDirection|fontScale" />

        <!-- TrackingModeActivity -->
        <activity
            android:name=".ui.TrackingModeActivity"
            android:label="@string/settings_tracking_mode"
            android:exported="false" />

        <!-- Health Connect — politique de confidentialité / rationale (exigé par Health Connect).
             Cible du lien « politique de confidentialité » sur l'écran de permissions. -->
        <activity
            android:name=".ui.HealthConnectRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ : accès à l'historique d'utilisation des permissions santé. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.HealthConnectRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- FileProvider pour export CSV -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
