default_platform(:android)

APP_PACKAGE = "com.macaron.luna"

platform :android do
  desc "Build Release AAB"
  lane :build do
    ks_path = ENV["KEYSTORE_PATH"] || File.expand_path("keystore/release.jks", "#{__dir__}/..")
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ".",
      properties: {
        "android.injected.signing.store.file" => ks_path,
        "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"] || "",
        "android.injected.signing.key.alias" => ENV["KEY_ALIAS"] || "luna",
        "android.injected.signing.key.password" => ENV["KEY_PASSWORD"] || ""
      }
    )
  end

  desc "Build Debug APK"
  lane :debug do
    gradle(task: "assemble", build_type: "Debug", project_dir: ".")
  end

  desc "Upload to Play Store internal track"
  lane :beta do
    build
    upload_to_play_store(
      package_name: APP_PACKAGE,
      track: "internal",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"
    )
    UI.success("Luna uploaded to Google Play Internal track")
  end

  desc "Promote internal → production"
  lane :release do
    upload_to_play_store(
      package_name: APP_PACKAGE,
      track: "internal",
      track_promote_to: "production",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_changelogs: false
    )
    UI.success("Luna promoted to Google Play Production — review pending")
  end

  desc "Promote internal to production"
  lane :promote do
    upload_to_play_store(
      package_name: APP_PACKAGE,
      track: "internal",
      track_promote_to: "production",
      json_key_data: ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
