require "fileutils"
require "tmpdir"

default_platform(:ios)

IOS_STORE_LOCALES = [
  "ar-SA", "bg", "bn", "ca", "cs", "da", "de-DE", "el", "en-US", "es-ES",
  "et", "fa", "fi", "fil", "fr-FR", "he", "hi", "hr", "hu", "id", "it",
  "ja", "ka", "ko", "lt", "lv", "mk", "ms", "nb", "nl-NL", "pl", "pt-BR",
  "pt-PT", "ro", "ru", "sk", "sl", "sr", "sv", "sw", "th", "tr", "uk", "ur",
  "vi", "zh-Hans", "zh-Hant"
].freeze

def stage_store_locales(source_dir, locales)
  staged_dir = Dir.mktmpdir("luna-store-locales-")
  locales.each do |locale|
    source = File.join(source_dir, locale)
    next unless Dir.exist?(source)
    FileUtils.cp_r(source, staged_dir)
  end
  staged_dir
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"] || "48GLJZYX5K",
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de74-3cdf-47e3-e053-5b8c7c11a4d1",
    key_filepath: ENV["ASC_KEY_FILEPATH"] || "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_48GLJZYX5K.p8",
    in_house: false
  )
end

platform :ios do

  desc "Build Rust core for iOS device (arm64)"
  lane :build_rust do
    sh "cd #{ENV['PWD']} && IPHONEOS_DEPLOYMENT_TARGET=16.0 cargo build --target aarch64-apple-ios --release -p luna-core"
    sh "cp #{ENV['PWD']}/target/aarch64-apple-ios/release/libluna_core.a #{ENV['PWD']}/ios-app/LunaApp/Generated/libluna_core.a"
    UI.success "Rust core built for aarch64-apple-ios"
  end

  desc "Archive and export IPA for App Store"
  lane :build do
    build_rust

    gym(
      project: "ios-app/LunaApp.xcodeproj",
      scheme: "LunaApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "P36X572LL9",
        signingStyle: "automatic"
      },
      output_directory: "/tmp/fastlane_build",
      output_name: "LUNA.ipa",
      clean: false,
      xcargs: "IPHONEOS_DEPLOYMENT_TARGET=16.0 DEVELOPMENT_TEAM=P36X572LL9"
    )
    UI.success "IPA exported to /tmp/fastlane_build/LUNA.ipa"
  end

  desc "Upload IPA to App Store Connect (TestFlight)"
  lane :upload_testflight do
    api_key = asc_api_key

    pilot(
      api_key: api_key,
      ipa: "/tmp/fastlane_build/LUNA.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Privacy-first cycle tracking. AES-256 encryption. No cloud. No tracking."
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    api_key = asc_api_key
    staged_metadata = stage_store_locales("./fastlane/metadata/ios", IOS_STORE_LOCALES)
    staged_screenshots = stage_store_locales("./fastlane/screenshots/ios", IOS_STORE_LOCALES)

    begin
      deliver(
        api_key: api_key,
        app_version: "0.1.0",
        ipa: "/tmp/fastlane_build/LUNA.ipa",
        submit_for_review: false,
        automatic_release: false,
        force: true,
        skip_binary_upload: true,
        metadata_path: staged_metadata,
        screenshots_path: staged_screenshots,
        precheck_include_in_app_purchases: false,
        ignore_language_directory_validation: true,
        overwrite_screenshots: true,
        privacy_url: {
          'default' => 'https://privacy.macaron-software.com/luna'
        },
        primary_category: 'HEALTH_AND_FITNESS',
      )
    ensure
      FileUtils.remove_entry(staged_metadata) if staged_metadata && Dir.exist?(staged_metadata)
      FileUtils.remove_entry(staged_screenshots) if staged_screenshots && Dir.exist?(staged_screenshots)
    end
  end

  desc "Capture screenshots for App Store"
  lane :screenshots do
    api_key = asc_api_key
    capture_screenshots(
      scheme: "LunaUITests",
      output_directory: "./fastlane/screenshots/ios",
      ios_version: "16.0"
    )
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true
    )
  end

  desc "Create App ID + App Store Connect app"
  lane :create_app do
    require 'jwt'
    require 'net/http'
    key_id = ENV["ASC_KEY_ID"] || "48GLJZYX5K"
    issuer_id = ENV["ASC_ISSUER_ID"] || "69a6de74-3cdf-47e3-e053-5b8c7c11a4d1"
    private_key_path = ENV["ASC_KEY_FILEPATH"] || "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_48GLJZYX5K.p8"
    private_key = OpenSSL::PKey::EC.new(File.read(private_key_path))
    now = Time.now.to_i
    payload = { iss: issuer_id, iat: now, exp: now + 1200, aud: "appstoreconnect-v1" }
    token = JWT.encode(payload, private_key, "ES256", { kid: key_id, typ: "JWT" })

    headers = { "Authorization" => "Bearer #{token}", "Content-Type" => "application/json" }
    base = "https://api.appstoreconnect.apple.com/v1"

    uri = URI("#{base}/bundleIds")
    body = {
      data: {
        type: "bundleIds",
        attributes: {
          name: "Luna",
          identifier: "com.macaron.luna",
          platform: "IOS"
        }
      }
    }.to_json

    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = true
    req = Net::HTTP::Post.new(uri, headers)
    req.body = body
    res = http.request(req)

    if res.code.to_i == 201
      bundle_id_resource_id = JSON.parse(res.body)["data"]["id"]
      UI.success("Bundle ID created (resource ID: #{bundle_id_resource_id})")
    elsif res.body.include?("DUPLICATE")
      UI.important("Bundle ID already exists")
      uri2 = URI("#{base}/bundleIds?filter[identifier]=com.macaron.luna")
      req2 = Net::HTTP::Get.new(uri2, headers)
      res2 = http.request(req2)
      bundle_id_resource_id = JSON.parse(res2.body)["data"][0]["id"]
    else
      UI.error("Bundle ID creation failed: #{res.code}")
    end

    uri3 = URI("#{base}/apps")
    app_body = {
      data: {
        type: "apps",
        attributes: {
          name: "Luna",
          bundleId: "com.macaron.luna",
          sku: "com.macaron.luna",
          primaryLocale: "en-US"
        },
        relationships: {
          bundleId: {
            data: { type: "bundleIds", id: bundle_id_resource_id }
          }
        }
      }
    }.to_json

    req3 = Net::HTTP::Post.new(uri3, headers)
    req3.body = app_body
    res3 = http.request(req3)

    if res3.code.to_i == 201
      UI.success("App created on App Store Connect!")
    elsif res3.body.include?("already exists")
      UI.important("App already exists")
    else
      UI.error("App creation response: #{res3.code}")
    end
  end

  desc "Full release: build + upload to TestFlight"
  lane :release do
    build
    upload_testflight
    UI.success "iOS v#{get_version_number(xcodeproj: 'ios-app/LunaApp.xcodeproj')} uploaded to TestFlight!"
  end

  desc "Submit existing build for App Store review (no binary upload)"
  lane :submit_for_review do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_version: "0.1.0",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: true,
        export_compliance_encryption_updated: false,
        export_compliance_is_exempt: true,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: true,
        export_compliance_available_on_french_store: true,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

end
