require "fileutils"
require "tmpdir"

default_platform(:ios)

IOS_STORE_LOCALES = ["en-US", "fr-FR"].freeze
ANDROID_STORE_LOCALES = ["en-US"].freeze

def stage_store_locales(source_dir, locales)
  staged_dir = Dir.mktmpdir("luna-store-locales-")
  locales.each do |locale|
    source = File.join(source_dir, locale)
    next unless Dir.exist?(source)

    FileUtils.cp_r(source, staged_dir)
  end
  staged_dir
end

# ASC API key (no password needed)
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"] || "48GLJZYX5K",
    issuer_id: ENV["ASC_ISSUER_ID"] || "69a6de74-3cdf-47e3-e053-5b8c7c11a4d1",
    key_filepath: ENV["ASC_KEY_FILEPATH"] || "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_48GLJZYX5K.p8",
    in_house: false
  )
end

# ─── iOS ─────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Build Rust core for iOS device (arm64)"
  lane :build_rust do
    sh "cd #{ENV['PWD']} && IPHONEOS_DEPLOYMENT_TARGET=16.0 cargo build --target aarch64-apple-ios --release -p luna-core"
    sh "cp #{ENV['PWD']}/target/aarch64-apple-ios/release/libluna_core.a #{ENV['PWD']}/ios-app/LunaApp/Generated/libluna_core.a"
    UI.success "Rust core built for aarch64-apple-ios"
  end

  desc "Archive and export IPA for App Store"
  lane :build do
    build_rust

    gym(
      project: "ios-app/LunaApp.xcodeproj",
      scheme: "LunaApp",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "P36X572LL9",
        signingStyle: "automatic"
      },
      output_directory: "/tmp/fastlane_build",
      output_name: "LUNA.ipa",
      clean: false,
      xcargs: "IPHONEOS_DEPLOYMENT_TARGET=16.0 DEVELOPMENT_TEAM=P36X572LL9"
    )
    UI.success "IPA exported to /tmp/fastlane_build/LUNA.ipa"
  end

  desc "Upload IPA to App Store Connect (TestFlight)"
  lane :upload_testflight do
    api_key = asc_api_key

    pilot(
      api_key: api_key,
      ipa: "/tmp/fastlane_build/LUNA.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Privacy-first cycle tracking. AES-256 encryption. No cloud. No tracking."
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    api_key = asc_api_key
    staged_metadata = stage_store_locales("./fastlane/metadata/ios", IOS_STORE_LOCALES)
    staged_screenshots = stage_store_locales("./fastlane/screenshots/ios", IOS_STORE_LOCALES)

    begin
      deliver(
        api_key: api_key,
        app_version: "0.1.0",
        ipa: "/tmp/LunaApp_export/LUNA.ipa",
        submit_for_review: false,
        automatic_release: false,
        force: true,
        skip_binary_upload: true,
        metadata_path: staged_metadata,
        screenshots_path: staged_screenshots,
        precheck_include_in_app_purchases: false,
        ignore_language_directory_validation: true,
        overwrite_screenshots: true,
        privacy_url: {
          'default' => 'https://privacy.macaron-software.com/luna'
        },
        primary_category: 'HEALTH_AND_FITNESS',
      )
    ensure
      FileUtils.remove_entry(staged_metadata) if staged_metadata && Dir.exist?(staged_metadata)
      FileUtils.remove_entry(staged_screenshots) if staged_screenshots && Dir.exist?(staged_screenshots)
    end
  end

  desc "Full release: build + upload to TestFlight"
  lane :release do
    build
    upload_testflight
    UI.success "iOS v#{get_version_number(xcodeproj: 'ios-app/LunaApp.xcodeproj')} uploaded to TestFlight!"
  end

  desc "Submit existing build for App Store review (no binary upload)"
  lane :submit_for_review do
    api_key = asc_api_key
    deliver(
      api_key: api_key,
      app_version: "0.1.0",
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      ignore_language_directory_validation: true,
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: true,
        export_compliance_encryption_updated: false,
        export_compliance_is_exempt: true,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: true,
        export_compliance_available_on_french_store: true,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload already-built IPA to App Store (shortcut)"
  lane :upload do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      ipa: "/tmp/LunaApp_export/LUNA.ipa",
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end

end

# ─── Android ─────────────────────────────────────────────────────────────────

platform :android do

  desc "Build signed AAB"
  lane :build do
    gradle(
      project_dir: "android-app",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => File.expand_path("android-app/keystore/luna-release.jks"),
        "android.injected.signing.store.password" => ENV["ANDROID_STORE_PASSWORD"] || "luna_store_2026",
        "android.injected.signing.key.alias" => "luna",
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"] || "luna_store_2026"
      }
    )
    UI.success "AAB built: android-app/app/build/outputs/bundle/release/app-release.aab"
  end

  desc "Upload AAB to Google Play (internal track, no assets)"
  lane :upload_internal do
    supply(
      package_name: "app.luna",
      aab: "android-app/app/build/outputs/bundle/release/app-release.aab",
      track: "internal",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || "fastlane/google-play-key.json",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload only metadata + screenshots (no binary)"
  lane :upload_store_assets do
    staged_metadata = stage_store_locales("fastlane/metadata/android", ANDROID_STORE_LOCALES)

    begin
      supply(
        package_name: "app.luna",
        track: "internal",
        json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || "fastlane/google-play-key.json",
        skip_upload_aab: true,
        skip_upload_apk: true,
        skip_upload_metadata: false,
        skip_upload_images: false,
        skip_upload_screenshots: false,
        metadata_path: staged_metadata
      )
    ensure
      FileUtils.remove_entry(staged_metadata) if staged_metadata && Dir.exist?(staged_metadata)
    end
  end

  desc "Full release: build + upload AAB to internal track"
  lane :release do
    build
    upload_internal
    UI.success "Android AAB uploaded to Play Store internal track!"
  end

  desc "Upload already-built AAB to Play Store (shortcut)"
  lane :upload do
    supply(
      package_name: "app.luna",
      aab: "android-app/app/build/outputs/bundle/release/app-release.aab",
      track: "internal",
      json_key: ENV["GOOGLE_PLAY_JSON_KEY"] || "fastlane/google-play-key.json",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

end
