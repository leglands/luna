require "fileutils"
require "tmpdir"
require "json"

default_platform(:ios)

APP_NAME        = "Luna".freeze
APP_BUNDLE_ID   = "com.macaron.luna".freeze
APP_VERSION     = "0.1.0".freeze
APP_CATEGORY    = "HEALTH_AND_FITNESS".freeze
APP_SCHEME      = "LunaApp".freeze
APP_PROJ        = "LunaApp.xcodeproj".freeze
APP_TEAM        = "P36X572LL9".freeze
APP_UPPER       = "LUNA".freeze

IOS_STORE_LOCALES = %w[
  ar-SA bg bn ca cs da de-DE el en-US es-ES et fa fi fil fr-FR he hi hr hu
  id it ja ka ko lt lv mk ms nb nl-NL pl pt-BR pt-PT ro ru sk sl sr sv sw
  th tr uk ur vi zh-Hans zh-Hant
].freeze

def asc_api_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("ASC_KEY_ID",      "48GLJZYX5K"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID",   "69a6de74-3cdf-47e3-e053-5b8c7c11a4d1"),
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH","#{Dir.home}/.appstoreconnect/private_keys/AuthKey_48GLJZYX5K.p8"),
    in_house: false
  )
end

def staged_locales(source_dir, tmp_prefix)
  staged = Dir.mktmpdir("#{tmp_prefix}-")
  IOS_STORE_LOCALES.each do |loc|
    src = File.join(source_dir, loc)
    FileUtils.cp_r(src, staged) if Dir.exist?(src)
  end
  staged
end

# ─── iOS ────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Build + archive IPA (iPhone/iPad)"
  lane :build do
    api_key = asc_api_key
    increment_build_number(
      build_number: (latest_testflight_build_number(api_key: api_key,
                       app_identifier: APP_BUNDLE_ID) + 1).to_s,
      xcodeproj: APP_PROJ
    ) rescue nil
    gym(
      project:          APP_PROJ,
      scheme:           APP_SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "/tmp/fastlane_build/#{APP_UPPER}",
      output_name:      "#{APP_UPPER}.ipa",
      clean:            false,
      xcargs:           "DEVELOPMENT_TEAM=#{APP_TEAM}"
    )
  end

  desc "Build macOS Catalyst pkg"
  lane :build_macos do
    gym(
      project:          APP_PROJ,
      scheme:           APP_SCHEME,
      configuration:    "Release",
      destination:      "platform=macOS,variant=Mac Catalyst",
      export_method:    "app-store",
      output_directory: "/tmp/fastlane_build/#{APP_UPPER}",
      output_name:      "#{APP_UPPER}-macos.pkg",
      xcargs:           "DEVELOPMENT_TEAM=#{APP_TEAM} SUPPORTS_MACCATALYST=YES"
    )
  end

  desc "Upload to TestFlight"
  lane :testflight do
    build
    pilot(
      api_key:                          asc_api_key,
      app_identifier:                   APP_BUNDLE_ID,
      ipa:                              "/tmp/fastlane_build/#{APP_UPPER}/#{APP_UPPER}.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                        "Privacy-first cycle tracking. AES-256 encrypted. Your data never leaves your device."
    )
    UI.success "#{APP_NAME} uploaded to TestFlight"
  end

  desc "Upload macOS build to TestFlight"
  lane :testflight_macos do
    build_macos
    pilot(
      api_key:                          asc_api_key,
      app_identifier:                   APP_BUNDLE_ID,
      pkg:                              "/tmp/fastlane_build/#{APP_UPPER}/#{APP_UPPER}-macos.pkg",
      skip_waiting_for_build_processing: true,
      changelog:                        "Privacy-first cycle tracking. AES-256 encrypted. Your data never leaves your device."
    )
  end

  desc "Upload metadata + screenshots (all 47 locales)"
  lane :metadata do
    api_key = asc_api_key
    meta    = staged_locales("./fastlane/metadata/ios",    "#{APP_UPPER}-meta")
    shots   = staged_locales("./fastlane/screenshots/ios", "#{APP_UPPER}-shots")
    begin
      deliver(
        api_key:                           api_key,
        app_identifier:                    APP_BUNDLE_ID,
        app_version:                       APP_VERSION,
        submit_for_review:                 false,
        automatic_release:                 false,
        force:                             true,
        skip_binary_upload:                true,
        metadata_path:                     meta,
        screenshots_path:                  shots,
        overwrite_screenshots:             true,
        ignore_language_directory_validation: true,
        precheck_include_in_app_purchases: false,
        primary_category:                  APP_CATEGORY,
        privacy_url:                       { 'default' => "https://privacy.macaron-software.com/#{APP_NAME.downcase}" }
      )
    ensure
      [meta, shots].each { |d| FileUtils.remove_entry(d) if d && Dir.exist?(d) }
    end
  end

  desc "Capture + upload screenshots"
  lane :screenshots do
    capture_screenshots(
      scheme:           "LunaUITests",
      output_directory: "./fastlane/screenshots/ios"
    )
    upload_to_app_store(
      api_key:              asc_api_key,
      app_identifier:       APP_BUNDLE_ID,
      skip_binary_upload:   true,
      skip_metadata:        true,
      overwrite_screenshots: true
    )
  end

  desc "Submit for App Store review"
  lane :submit do
    deliver(
      api_key:           asc_api_key,
      app_identifier:    APP_BUNDLE_ID,
      app_version:       APP_VERSION,
      submit_for_review: true,
      automatic_release: false,
      force:             true,
      skip_binary_upload: true,
      skip_metadata:     false,
      skip_screenshots:  true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:                       false,
        export_compliance_uses_encryption:           true,
        export_compliance_is_exempt:                 true,
        export_compliance_contains_proprietary_cryptography: true,
        content_rights_has_rights:                   true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Full release: build → TestFlight"
  lane :release do
    testflight
  end

  desc "Full macOS release: build → TestFlight"
  lane :release_macos do
    testflight_macos
  end

end
